NODE_ENV=development
PORT=4100
FRONTEND_URL=http://localhost:3001
PASSWORD_RESET_PATH=/auth/password-update
# Generate a new secret; never reuse What's Good's JWT secret.
JWT_SECRET=
# Use a dedicated Fussy Panda database and database user.
DB_DATABASE=fussy_panda
DB_USERNAME=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional local Unix socket, primarily for isolated tests.
DB_SOCKET=
GOOGLE_CLIENT_ID=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Fussy Panda <no-reply@example.com>
# Optional owner inbox for new email/password and Google account notifications.
SIGNUP_NOTIFICATION_EMAIL=
# Enable only for a frontend on a different site; requires HTTPS.
SESSION_SAME_SITE=lax
TRUST_PROXY=false

# Independent Fussy Panda storage project. Originals MUST use a private bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy public bucket only, for pre-trial account images; optional on a fresh installation.
SUPABASE_STORAGE_BUCKET=
SUPABASE_PRIVATE_STORAGE_BUCKET=
# Separate public bucket containing only reduced, watermarked previews.
SUPABASE_PREVIEW_STORAGE_BUCKET=
STUDIO_REFERENCE_URL_TTL_SECONDS=600
STUDIO_DOWNLOAD_URL_TTL_SECONDS=60
# Provider settings; use models available to your dedicated provider account.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_QA_MODEL=gpt-5.5
OPENAI_IMAGE_TIMEOUT_MS=300000
PHOTO_STUDIO_REFERENCE_TIMEOUT_MS=30000
PHOTO_GENERATION_MAX_RETRIES=1
# Independent Stripe account/test environment and monthly recurring price IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PHOTO_STUDIO_BASIC_PRICE_ID=
STRIPE_PHOTO_STUDIO_PRO_PRICE_ID=
STRIPE_PHOTO_STUDIO_ENTERPRISE_PRICE_ID=
PHOTO_STUDIO_TEMP_MAX_AGE_MS=3600000
PHOTO_STUDIO_CHAT_GENERATION_MAX_AGE_MS=1200000
PHOTO_STUDIO_CLEANUP_INTERVAL_MS=300000

# Guest active lifetime: default seven days, clamped to one minute through thirty days.
GUEST_TTL_MS=604800000
# Keep above provider timeout; a heartbeat renews active work every 30 seconds.
GUEST_WORK_LEASE_MS=1200000
# Per-process IP rate limits plus database-backed creation counts across instances.
GUEST_CREATION_WINDOW_MS=86400000
GUEST_CREATION_IP_LIMIT=10
GUEST_GENERATION_WINDOW_MS=900000
GUEST_GENERATION_IP_LIMIT=30
